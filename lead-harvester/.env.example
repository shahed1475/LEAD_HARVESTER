# ── ClarioScope API ──────────────────────────────────────────────────────────
# Base URL of the ClarioScope Laravel app
CLARIOSCOPE_URL=https://clarioscope.ai

# Shared bearer token — 64-char hex, generated by the founder.
# Set this BOTH here (on the Oracle VM) and in Laravel Cloud env vars.
HARVESTER_TOKEN=change_me_64_char_hex_secret_here

# ── Polling ───────────────────────────────────────────────────────────────────
# How long to wait (ms) between polls when no jobs are available
HARVESTER_POLL_INTERVAL_MS=30000

# ── Proxy ─────────────────────────────────────────────────────────────────────
# Rotating residential proxy endpoint — effectively mandatory at real volume.
# Leave blank to scrape direct (fine for local testing, will get banned at scale).
# Format: http://user:pass@proxy-host:port  OR  socks5://user:pass@host:port
PROXY_URL=

# ── Tuning ────────────────────────────────────────────────────────────────────
# Max leads per POST batch (spec cap = 200)
BATCH_SIZE=200

# Python log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
